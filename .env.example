# AgentHub Configuration
# Copy to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agenthub

# AI API (choose one)
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Qwen (DashScope)
DASHSCOPE_API_KEY=

# Wenxin (Baidu)
WENXIN_API_KEY=
WENXIN_SECRET_KEY=

# App
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production
